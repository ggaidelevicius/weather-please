# Optional: required for the hosted /bug form and Prisma CLI commands.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weather_please

# Optional calendar integrations. These values are bundled in the browser.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Use only the non-confidential value for an installed Google OAuth client.
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=
