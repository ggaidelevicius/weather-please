{
	"name": "weather-please",
	"version": "2.11.10",
	"description": "Savor the elegance and grace of Weather Please as it integrates flawlessly into your browser. A symphony of design and performance awaits – where weather meets artistry in the most subtle, yet captivating, manner.",
	"private": true,
	"author": {
		"name": "Gus Gaidelevicius"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ggaidelevicius/weather-please.git"
	},
	"homepage": "https://github.com/ggaidelevicius/weather-please",
	"bugs": {
		"url": "https://github.com/ggaidelevicius/weather-please/issues"
	},
	"funding": {
		"type": "individual",
		"url": "https://www.buymeacoffee.com/ggaidelevicius"
	},
	"license": "SEE LICENSE IN LICENSE.md",
	"scripts": {
		"dev": "next dev",
		"build": "node scripts/build-extension.mjs",
		"start": "next start",
		"lint": "oxlint . --fix",
		"release": "node scripts/release.mjs",
		"prepare": "husky",
		"test": "vitest run",
		"build:extension": "node scripts/build-extension.mjs",
		"build:web": "pnpm db:generate && next build",
		"typecheck": "next typegen && tsc --noEmit",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"test:browser": "playwright test",
		"source:archive": "node scripts/package-source.mjs",
		"source:verify": "node scripts/verify-source-build.mjs",
		"format": "oxfmt . --write"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@lingui/core": "^6.9.0",
		"@lingui/react": "^6.9.0",
		"@photostructure/tz-lookup": "^11.7.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-three/fiber": "^9.8.1",
		"@tabler/icons-react": "^3.49.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"astronomy-engine": "^2.1.19",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"framer-motion": "^14.0.0",
		"next": "16.4.0",
		"postcss": "^8.5.29",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@lingui/babel-plugin-lingui-macro": "^6.9.0",
		"@lingui/cli": "^6.9.0",
		"@playwright/test": "^1.64.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"adm-zip": "^0.6.1",
		"babel-plugin-react-compiler": "19.1.0-rc.2",
		"dotenv": "^18.0.6",
		"eslint-plugin-perfectionist": "^5.12.1",
		"fs-extra": "^11.4.1",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"prisma": "^7.10.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.10.1",
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --fix --no-error-on-unmatched-pattern",
		"*": "oxfmt --write --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.8.1",
			"onFail": "download"
		}
	},
	"browserslist": [
		"chrome >= 144",
		"firefox >= 139"
	]
}
