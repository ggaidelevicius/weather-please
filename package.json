  "bugs": {
    "url": "https://github.com/ggaidelevicius/weather-please/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://www.buymeacoffee.com/ggaidelevicius"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-extension.mjs",
    "start": "next start",
    "lint": "pnpm tsc && pnpm prettier . --write && pnpm eslint --fix",
    "release": "pnpm build && node scripts/release.mjs",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
