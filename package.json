{
	"name": "weather-please",
	"version": "2.11.8",
	"description": "Savor the elegance and grace of Weather Please as it integrates flawlessly into your browser. A symphony of design and performance awaits – where weather meets artistry in the most subtle, yet captivating, manner.",
	"private": true,
	"author": {
		"name": "Gus Gaidelevicius"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ggaidelevicius/weather-please.git"
	},
	"homepage": "https://github.com/ggaidelevicius/weather-please",
	"bugs": {
		"url": "https://github.com/ggaidelevicius/weather-please/issues"
	},
	"funding": {
		"type": "individual",
		"url": "https://www.buymeacoffee.com/ggaidelevicius"
	},
	"license": "SEE LICENSE IN LICENSE.md",
	"scripts": {
		"dev": "next dev",
		"build": "node scripts/build-extension.mjs",
		"start": "next start",
		"lint": "pnpm tsc && pnpm prettier . --write && pnpm eslint --fix",
		"release": "node scripts/release.mjs",
		"prepare": "husky",
		"test": "vitest run",
		"build:extension": "node scripts/build-extension.mjs",
		"build:web": "pnpm db:generate && next build --webpack",
		"typecheck": "next typegen && tsc --noEmit",
		"format:check": "prettier . --check",
		"format:fix": "prettier . --write",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"test:browser": "playwright test",
		"source:archive": "node scripts/package-source.mjs",
		"source:verify": "node scripts/verify-source-build.mjs"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@lingui/core": "^6.7.0",
		"@lingui/react": "^6.7.0",
		"@photostructure/tz-lookup": "^11.7.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-three/fiber": "^9.7.0",
		"@tabler/icons-react": "^3.47.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"astronomy-engine": "^2.1.19",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"framer-motion": "^13.4.0",
		"next": "16.3.5",
		"postcss": "^8.5.28",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@lingui/babel-plugin-lingui-macro": "^6.7.0",
		"@lingui/cli": "^6.7.0",
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"adm-zip": "^0.6.1",
		"babel-plugin-react-compiler": "19.1.0-rc.2",
		"dotenv": "^18.0.1",
		"eslint": "^9",
		"eslint-config-next": "16.3.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.11.1",
		"fs-extra": "^11.4.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"jsdom": "^30.1.0",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.8",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^7.10.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.5.1",
	"lint-staged": {
		"*.{js,jsx,mjs,cjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write",
			"bash -c 'tsc --noEmit'"
		],
		"*.{json,css,md}": "prettier --write"
	},
	"engines": {
		"node": ">=24"
	},
	"browserslist": [
		"chrome >= 111",
		"edge >= 111",
		"firefox >= 111",
		"safari >= 16.4"
	]
}
