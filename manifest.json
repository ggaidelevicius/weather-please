{
	"manifest_version": 3,
	"name": "__MSG_appName__",
	"version": "2.11.6",
	"description": "__MSG_appDesc__",
	"author": "Gus Gaidelevicius",
	"default_locale": "en",
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"permissions": [
		"geolocation",
		"identity",
		"declarativeNetRequestWithHostAccess"
	],
	"host_permissions": ["https://tile.openstreetmap.org/*"],
	"declarative_net_request": {
		"rule_resources": [
			{
				"enabled": true,
				"id": "openstreetmap_tile_headers",
				"path": "openstreetmap-tile-rules.json"
			}
		]
	},
	"icons": {
		"128": "favicon.png"
	}
}
