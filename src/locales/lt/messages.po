msgid "thunderstorm"
msgstr "perkūnija"

#: src/features/weather/ui/tile.tsx:120
msgid "thunderstorm with heavy hail"
msgstr "perkūnija su stipria kruša"

#: src/features/weather/ui/tile.tsx:119
msgid "thunderstorm with slight hail"
msgstr "perkūnija su nedidele kruša"

#: src/features/weather/ui/tile.tsx:128
msgid "Thursday"
msgstr "Ketvirtadienis"

#: src/features/seasonal-events/meteor-showers/viewing-guide.tsx:140
msgid "Times in {timeZoneLabel}"
msgstr "Laiko juosta: {timeZoneLabel}"

#: src/features/seasonal-events/meteor-showers/viewing-guide.tsx:151
msgid "to"
