#: src/features/weather/ui/tile.tsx:476
msgid "The maximum temperature will be {0} degrees fahrenheit."
msgstr "Aukščiausia temperatūra bus {0} laipsniai pagal Farenheitą."

#. placeholder {0}: Math.round(uv)
#: src/features/weather/ui/tile.tsx:534
msgid "The maximum UV index will be {0}."
msgstr "Didžiausias UV indeksas bus {0}."

